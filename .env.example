# Copy to .env, then enter your API key locally. Never commit .env.
API_KEY=
STOP_IDS=0454,0133,0857,10062
POLL_SECONDS=15
# Set only if your API account requires a named feed:
# API_FEED=bustime
# Native matrix builds: path to the upstream 5x7 BDF font.
# MATRIX_FONT=/opt/rpi-rgb-led-matrix/fonts/5x7.bdf
